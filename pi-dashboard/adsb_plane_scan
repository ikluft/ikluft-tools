#!/usr/bin/env python3
# pylint: disable=line-too-long
"""
adsb_plane_scan - send alert for airplane transponders matching multiple ADS-B search criteria
This was originally just alerting when a transponder was turned on matching a search ID.
This uses the SkySnoop module and a tar1090-based tracking service
by Ian Kluft
January 2026
"""

import asyncio
from datetime import datetime
import json
from pathlib import Path
import sys
import subprocess
from time import sleep
from zoneinfo import ZoneInfo

import requests
from skysnoop import SkySnoop, SkyData
from skysnoop.exceptions import (
    SkySnoopError,
    APIError,
    ValidationError,
    TimeoutError as SnoopTimeoutError,
    RateLimitError,
)
from playsound3 import playsound

REQUIRED_FIELDS = [
    "timezone",
    "ntfy_url_prefix",
    "ntfy_topic",
    "ntfy_priority",
    "ntfy_message",
]
OPTIONAL_FIELDS = [
    "hex_id",
    "tail-reg",
    "callsign",
    "lat",
    "lon",
    "radius",
    "condition",
    "sound_path",
    "alert_speak",
]

# query retry interval management
SHORT_INTERVAL_BASE = 180
SHORT_INTERVAL_MAX = 360
SHORT_INCREMENT = 30
LONG_INTERVAL_BASE = 300
LONG_INTERVAL_MAX = 1800
LONG_INCREMENT = 300

# TRACKING_SITE = "adsb.lol"
TRACKING_SITE = "globe.airplanes.live"
ADSB_ICAO_PREFIX = f"https://{TRACKING_SITE}/?icao="
ADSB_REG_PREFIX = f"https://{TRACKING_SITE}/?reg="


def timestamp(conf_data: dict | list(dict)) -> str:
    """return current timestamp as string"""
    if isinstance(conf_data, dict):
        return datetime.now(ZoneInfo(conf_data["timezone"])).isoformat(
            sep=" ", timespec="seconds"
        )

    # find first timestamp in list of dict (TODO: global timezone config)
    if isinstance(conf_data, list):
        for query in conf_data:
            if 'timezone' in query:
                return datetime.now(ZoneInfo(query["timezone"])).isoformat(
                    sep=" ", timespec="seconds"
                )

    # reject parameter data type if we get here
    raise TypeError('timestamp(conf_data) received conf_data of type ' + str(conf_data.__class__))


def interval_str(sec: int | None) -> str:
    """compute readable interval string from integer seconds"""
    if sec is None:
        return "None"
    if sec < 0:
        sec = 0
        return "0sec"
    remainder = int(sec)
    out_hr = int(remainder / 3600)
    remainder -= 3600 * out_hr
    out_min = int(remainder / 60)
    remainder -= 60 * out_min
    out_sec = remainder
    result = []
    if out_hr > 0:
        result.append(f"{out_hr}hr")
    if out_min > 0:
        result.append(f"{out_min}min")
    if out_sec > 0:
        result.append(f"{out_sec}sec")
    return " ".join(result)


def gen_click_str(aircraft, conf_data: dict) -> str:
    """generate click-link to send with notification"""
    if "hex_id" in conf_data:
        return ADSB_ICAO_PREFIX + conf_data["hex_id"]
    if "tail-reg" in conf_data or "callsign" in conf_data:
        return ADSB_ICAO_PREFIX + aircraft.hex.strip()
    raise KeyError("missing alert field: need hex_id, tail-reg or callsign")


def send_ntfy(aircraft, conf_data: dict) -> None:
    """send alert to ntfy server (such as ntfy.sh or self-hosted)"""
    click_str = gen_click_str(aircraft, conf_data)
    hex_str = aircraft.hex.strip() if aircraft.hex is not None else "n/a"
    reg_str = aircraft.registration.strip() if aircraft.registration is not None else "n/a"
    callsign_str = aircraft.callsign.strip() if aircraft.callsign is not None else "n/a"
    actype_str = aircraft.type.strip() if aircraft.type is not None else "n/a"
    requests.post(
        conf_data["ntfy_url_prefix"] + conf_data["ntfy_topic"],
        data=f"ADS-B scan found hex={hex_str} reg={reg_str} call={callsign_str} type={actype_str}",
        timeout=90,
        headers={
            "Title": conf_data["ntfy_message"],
            "Priority": conf_data["ntfy_priority"],
            "Tags": "airplane",
            "Click": click_str,
        },
    )


def speak(words: str) -> None:
    """speech synthesis interface"""
    subprocess.run(["/usr/bin/speak-ng", words], check=True)


def alert_detected(aircraft, conf_data) -> None:
    """play alert/alarm sound until stopped"""
    hex_str = conf_data["hex_id"] + "/" \
        if "hex_id" in conf_data and len(conf_data["hex_id"]) > 0 \
        else ""
    reg_str = aircraft.registration.strip() if aircraft.registration is not None else "n/a"
    print(
        "alert "
        + hex_str
        + " "
        + reg_str
        + " detected at "
        + timestamp(conf_data)
    )

    print(repr(aircraft))
    send_ntfy(aircraft, conf_data)
    if "alert_speak" in conf_data and len(conf_data["alert_speak"]) > 0:
        while True:
            if "sound_path" in conf_data and len(conf_data["sound_path"]) > 0:
                playsound(conf_data["sound_path"])
            speak(conf_data["alert_speak"])
            sleep(10)


def query_has(query: dict, field: str | list(str)) -> bool:
    """check if a query defined in a dictionary has one or more named fields which are nonempty"""
    if isinstance(field, str):
        return str in query and len(query[str]) > 0
    if isinstance(field, list):
        for fname in field:
            if fname not in query or len(query[fname]) == 0:
                return False
        return True
    raise TypeError('query_has(dict, field) received field of type ' + str(field.__class__))


def process_response(query: dict, resp: SkyData) -> None:
    """process SkyData response from SkySnoop"""
    if resp.has_results:
        for aircraft in resp.aircraft:
            if "condition" in query:
                pass  # process response sifting for conditions found in query (TODO)
            alert_detected(aircraft, query)


async def snoop(conf_data: list(dict)):
    """loop through async scan"""
    # give query to SkySnoop, get response
    try:
        async with SkySnoop(backend="openapi") as client:
            for query in conf_data:
                if query_has(query, "hex_id"):
                    # Query by ICAO hex, if provided
                    response = await client.get_by_hex(query["hex_id"])
                elif query_has(query, "tail-reg"):
                    # Query by registration
                    response = await client.get_by_registration(query["tail-reg"])
                elif query_has(query, "callsign"):
                    # query by callsign
                    response = await client.get_by_callsign(query["callsign"])
                elif query_has(query, ["lat", "lon", "radius"]):
                    # query by callsign
                    response = await client.get_in_circle(lat=query["lat"], lon=query["lon"], radius=query["radius"])
                else:
                    raise KeyError("missing search field: need hex_id, tail-reg or callsign")
                process_response(query, response)

    # timeout is handled differently from other exceptions and not re-raised
    except SnoopTimeoutError:
        print("Request timed out at " + timestamp(conf_data))
        # intentionally different - do not re-raise timeout

    # most exceptions are re-raised to send them back to main()
    except ValidationError as e:
        print(f"Invalid parameter: {e} at " + timestamp(conf_data))
        raise
    except RateLimitError as e:
        print("Rate limit error: retry after " + interval_str(e.retry_after) + " at " + timestamp(conf_data))
        raise
    except APIError as e:
        print(f"API error: {e} at " + timestamp(conf_data))
        raise
    except KeyboardInterrupt as e:
        print(f"keyboard interrupt {e} at " + timestamp(conf_data))
        raise
    except SkySnoopError as e:
        print(f"SkySnoop Error: {e} at " + timestamp(conf_data))
        raise


def get_config() -> list[dict]:
    """read configuration data from JSON file specified on command-line argument"""
    # check arguments
    if len(sys.argv) <= 1:
        raise IndexError("missing configuration file argument")
    config_file = sys.argv[1]
    config_path = Path(config_file)

    # read JSON data
    with open(config_path, mode="r", encoding="utf-8") as read_config:
        query_data = json.load(read_config)

    # check JSON data
    if not isinstance(query_data, dict):
        raise KeyError("configuration JSON data is not a dictionary")
    missing_fields: list[str] = []
    unrecognized_fields: list[str] = []
    for field in REQUIRED_FIELDS:
        if field not in query_data:
            missing_fields.append(field)
    for key in list(query_data):
        if key not in REQUIRED_FIELDS and key not in OPTIONAL_FIELDS:
            unrecognized_fields.append(key)
    if len(missing_fields) > 0 or len(unrecognized_fields) > 0:
        attr_errs: list[str] = []
        if len(missing_fields > 0):
            attr_errs.append("missing configuration data: " + ",".join(missing_fields))
        if len(unrecognized_fields > 0):
            attr_errs.append("unrecognized fields/possible typos: " + ",".join(unrecognized_fields))
        raise AttributeError("\n".join(attr_errs))

    # return configuration
    return [query_data]


def totals_str(totals: dict) -> str:
    """generate a readable string with summary of total times in each type of waiting"""
    result = []
    for wtype in ["sleep", "ratelimit", "overload", "error", "n/a"]:
        if wtype in totals:
            result.append(wtype + " = " + interval_str(totals[wtype]))
    return ", ".join(result)


def main() -> int:
    """main control loop"""
    config_data = get_config()
    print("config: " + repr(config_data))
    print("scan begins " + timestamp(config_data))

    # main loop with retry and error handling
    long_interval = LONG_INTERVAL_BASE
    short_interval = SHORT_INTERVAL_BASE
    wait_totals = {}
    while True:
        interval = short_interval  # set wait interval to short time unless overridden later by rate limit or error
        wait_type = "n/a"
        try:
            # call snoop() to run SkySnoop request and get response or error
            asyncio.run(snoop(config_data))

        # handle rate limiting
        except RateLimitError as e:
            interval = (e.retry_after + SHORT_INCREMENT) if e.retry_after is not None else long_interval
            wait_type = "ratelimit" if e.retry_after is not None else "overload"

            # increasing back-off with repeated rate limiting
            if long_interval < LONG_INTERVAL_MAX:
                long_interval += LONG_INCREMENT
            if short_interval < SHORT_INTERVAL_MAX:
                short_interval += SHORT_INCREMENT

            print("wait " + interval_str(interval) + " at " + timestamp(config_data))

        # catch all errors from the SkySnoop package
        except SkySnoopError:
            interval = long_interval  # longer wait without additional back-off after error
            wait_type = "error"
            print("wait " + interval_str(interval) + " at " + timestamp(config_data))

        # exit on keyboard interrupt (CTRL-C), reporting stats
        except KeyboardInterrupt:
            print("keyboard interrupt during sleep " + interval_str(interval) + " at " + timestamp(config_data))
            print("[totals: " + totals_str(wait_totals) + "]")
            return 0

        # when no errors occur, decrement short interval toward base level and reset long interval
        else:
            long_interval = LONG_INTERVAL_BASE
            if short_interval > SHORT_INTERVAL_BASE:
                short_interval -= SHORT_INCREMENT
            wait_type = "sleep"

        # save wait time stats
        if wait_type not in wait_totals:
            wait_totals[wait_type] = 0
        wait_totals[wait_type] += interval
        if wait_type != "sleep":
            print("wait(" + wait_type + ") " + interval_str(interval) + " at " + timestamp(config_data)
                  + " [totals: " + totals_str(wait_totals) + "]")

        # perform sleep for the computed interval
        try:
            sleep(interval)

        # exit on keyboard interrupt (CTRL-C), reporting stats
        except KeyboardInterrupt:
            print("keyboard interrupt during sleep " + interval_str(interval) + " at " + timestamp(config_data))
            print("[totals: " + totals_str(wait_totals) + "]")
            return 0


if __name__ == '__main__':
    sys.exit(main())
